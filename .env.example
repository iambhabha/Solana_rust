# Database Configuration
# Local SQLite database file - random name bhi de sakte ho
DATABASE_URL=users.db

# JWT Secret (RANDOM VALUE - abhi random dal diya hai, production mein strong use karo)
# Generate karne ke liye: https://www.random.org/strings/ (32+ characters)
JWT_SECRET=a8f5f167f44f4964e6c998dee827110c5b8d8e8f9a2b3c4d5e6f7a8b9c0d1e2f3

# Encryption Key (RANDOM VALUE - abhi random dal diya hai)
# Must be exactly 64 hex characters (32 bytes)
# Generate karne ke liye: https://www.random.org/bytes/ (32 bytes, hex format)
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456

# Solana Configuration
# ⚠️ IMPORTANT: Yeh value tumhe Helius ya Alchemy se lani hogi
# 
# Option 1: Helius (Recommended)
#   1. Visit: https://www.helius.dev/
#   2. Sign up / Login
#   3. Create new project
#   4. Copy Mainnet RPC URL
#   5. Format: https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
#
# Option 2: Alchemy
#   1. Visit: https://www.alchemy.com/
#   2. Sign up / Login  
#   3. Create Solana app
#   4. Copy Mainnet RPC URL
#   5. Format: https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
# Abhi ke liye example URL (REPLACE KARNA HOGI):
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# KARMM Token Mint Address
# ⚠️ IMPORTANT: Yeh tumhare KARMM token ka mint address hai Solana mainnet par
# 
# Kaha se milega:
#   1. Solana Explorer par jao: https://explorer.solana.com/
#   2. Apne token ka address search karo
#   3. Ya token deploy karte waqt mila hoga
#   4. Format: Base58 encoded string (44 characters)
#
# Abhi ke liye example (REPLACE KARNA HOGI):
KARMM_MINT_ADDRESS=YOUR_KARMM_MINT_ADDRESS_HERE

# Master Wallet Private Key
# ⚠️ IMPORTANT: Yeh treasury wallet hai jo tokens distribute karega
# 
# Kaha se banega:
#   Option 1: Solana CLI se (Recommended)
#      solana-keygen new --outfile master-wallet.json --no-bip39-passphrase
#      Phir private key extract karo (128 hex characters)
#
#   Option 2: Rust script se
#      Temporary script banao aur keypair generate karo
#
#   Option 3: Phantom wallet se export (agar already hai)
#
# Format: Exactly 128 hex characters (64 bytes)
# Abhi ke liye example (REPLACE KARNA HOGI - yeh random hai):
MASTER_WALLET_PRIVATE_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Server Configuration
# Port number - local ke liye 3000 theek hai
SERVER_PORT=3000
